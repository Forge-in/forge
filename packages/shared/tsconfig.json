{
  "extends": "@forge/tsconfig/base.json",
  "compilerOptions": {
    // Emitted as CommonJS so every consumer can use it unchanged: the NestJS
    // API (CJS at runtime), Next.js, and Metro. See README "Why shared is built".
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
