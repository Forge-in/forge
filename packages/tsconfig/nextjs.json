{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Forge Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    // Next compiles with SWC and needs bundler resolution + DOM libs, so these
    // override the Node-oriented defaults in base.json.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "declaration": false,
    "plugins": [{ "name": "next" }]
  }
}
