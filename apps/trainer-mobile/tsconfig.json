{
  // Array extends: repo-wide strictness first, then Expo's RN-specific settings
  // (jsx, bundler resolution, lib) which must win on the keys they define.
  // `expo/tsconfig.base` is resolved from this app, so it stays listed here
  // rather than inside @forge/tsconfig.
  "extends": ["@forge/tsconfig/react-native.json", "expo/tsconfig.base"],
  "compilerOptions": {
    // Re-asserted after the Expo preset, which does not set them.
    "noEmit": true,
    "declaration": false
  }
}
