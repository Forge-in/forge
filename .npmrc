# Shorten the directory names pnpm generates inside node_modules/.pnpm.
#
# pnpm's default is 120 characters, which produces entries such as
#   expo-modules-core@57.0.10_react-native@0.86.2_@babel+core@7.29.7_@react-native+jest-preset@0._wwjbybhl5lhkcir7mz52sbesny
#
# The Android build then nests its own tree under that directory, and on Windows
# the result exceeds the 260-character MAX_PATH limit. Enabling long paths in the
# registry does not rescue this: CreateProcess (used by Gradle to launch the
# CMake/prefab helper scripts) has a hard MAX_PATH limit and cannot be made
# long-path aware, so the build fails with
#   CXX1428 ... prefab_command.bat ... CreateProcess error=2
#
# 40 characters keeps every generated Android path comfortably under the limit.
# Uniqueness is unaffected - pnpm always appends a content hash to the name.
# On Linux and macOS this setting is harmless; it only makes the tree tidier.
#
# Changing this value requires a full `pnpm install` to rename the virtual store.
virtual-store-dir-max-length=40
