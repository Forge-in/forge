# The environment the `e2e` job runs under. ONE file rather than an `env:` block in ci.yml,
# for a reason that has already cost this repo a debugging session:
#
# `turbo run test:e2e` FILTERS the environment. A variable exported by the workflow but
# absent from `passThroughEnv` in turbo.json never reaches the process — the API silently
# falls back to its default and the symptom is a 429 in a test that has nothing to do with
# rate limiting. Running jest directly hides it completely, because that path bypasses turbo.
#
# Keeping the list here makes the two halves mechanically checkable:
# `scripts/check-repo-hygiene.mjs` asserts every key below is either declared in turbo.json's
# passThroughEnv or explicitly exempted as a non-application variable. Adding a variable to
# this file without wiring turbo now fails CI instead of producing a confusing 429.
#
# Format: KEY=VALUE, one per line. No quotes, no expansion, no multi-line values — the job
# appends this file to $GITHUB_ENV verbatim, and $GITHUB_ENV does not support them.
#
# NOTHING SECRET BELONGS HERE. Every value is a throwaway that satisfies a boot-time schema.

# ─── Database ────────────────────────────────────────────────────────────────────────────
# Two URLs, two roles. This split is the whole point: forge_app owns nothing and has
# NOBYPASSRLS, so if the isolation tests were accidentally run as the owner (or as a
# superuser) they would pass for the wrong reason and prove nothing.
SUPERUSER_URL=postgresql://forge:forge_ci_pw@localhost:5432/forge
DATABASE_MIGRATION_URL=postgresql://forge_migrator:mig_ci_pw@localhost:5432/forge
DATABASE_URL=postgresql://forge_app:app_ci_pw@localhost:5432/forge

# Required by /readyz and by rate limiting. Not optional in CI for the same reason it is not
# optional at runtime: an in-memory fallback would make the tests pass while the behaviour
# they cover silently stops working across multiple containers.
REDIS_URL=redis://localhost:6379

# ─── Boot-time contract ──────────────────────────────────────────────────────────────────
# Throwaway values that satisfy the schema (>= 32 chars, not placeholders, and distinct from
# each other — env.schema.ts rejects equal access/refresh secrets). Real secrets never touch
# this suite; nothing here verifies a token against anything outside the process.
JWT_ACCESS_SECRET=ci_access_secret_that_is_long_enough_1234567890
JWT_REFRESH_SECRET=ci_refresh_secret_that_is_long_enough_0987654321
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NODE_ENV=test
LOG_LEVEL=warn

# ─── Rate limits: headroom, not disablement ──────────────────────────────────────────────
# Every request in CI comes from 127.0.0.1, so the production per-IP limits would block the
# suite after ten OTP requests — a security control that cannot be exercised is one nobody
# notices breaking. The per-PHONE limits stay at their defaults and ARE asserted end to end,
# because each test uses a fresh number.
OTP_MAX_PER_IP=100000
# The console keeps its own per-IP bucket, so it needs its own headroom for the same reason.
ADMIN_OTP_MAX_PER_IP=100000
THROTTLE_PER_SECOND=10000
THROTTLE_PER_MINUTE=100000
