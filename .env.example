# ---- Postgres (local docker) ----
# The superuser the container starts with. Used ONLY to run
# packages/db/sql/bootstrap-roles.sql, which creates the two roles below. The application
# must never connect as this user: it is a superuser, so it bypasses row-level security and
# every tenant policy in the schema becomes decorative.
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_pw
POSTGRES_DB=forge

# Runtime connection. forge_app: owns nothing, creates nothing, NOBYPASSRLS.
# This is the only URL the API opens.
DATABASE_URL=postgresql://forge_app:app_dev_pw@localhost:5432/forge

# Migrations only, as a separate release step before the new version boots.
# forge_migrator owns the tables and can run DDL; the runtime role deliberately cannot, so
# a compromised API process cannot rewrite the schema or drop a policy.
DATABASE_MIGRATION_URL=postgresql://forge_migrator:mig_dev_pw@localhost:5432/forge

# Optional read replica for withTenantRead(). Falls back to DATABASE_URL when unset —
# the split exists in code from day one so adopting a replica is config, not a refactor.
# DATABASE_READ_URL=

# First-time setup (creates forge_app and forge_migrator):
#   psql "postgresql://forge:forge_dev_pw@localhost:5432/forge" \
#     -v migrator_password=mig_dev_pw -v app_password=app_dev_pw \
#     -f packages/db/sql/bootstrap-roles.sql
#   pnpm --filter @forge/db db:migrate

# ---- Redis (local docker) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT (generate strong random values; NEVER commit real ones) ----
# Validated at boot: minimum 32 characters, must not start with a placeholder word, and
# the two secrets must differ — sharing them would let a refresh token be presented as an
# access token. The API refuses to start otherwise, rather than signing with `undefined`.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900          # 15 min in seconds
JWT_REFRESH_TTL=2592000     # 30 days in seconds

# Company admin console sessions. Separate from the member apps on purpose: thirty days of
# silent refresh is right for a phone in a member's pocket and wrong for a console that can
# reach every tenant, where a laptop left open in a cafe should stop being a valid session
# the same day. Rejected at boot if the console refresh TTL exceeds the member one — that
# inversion would make the most privileged surface the longest-lived.
#
# The SECRETS are shared with the member tokens; the `aud` claim is what keeps the two
# apart. A third key would be another thing to rotate for no extra property.
JWT_CONSOLE_ACCESS_TTL=900    # 15 min
JWT_CONSOLE_REFRESH_TTL=43200 # 12 hours — a working day plus slack

# ---- Company admin console ----
# The same OTP dials as the member apps, counted in their own Redis buckets. Separate
# because a shared per-phone bucket lets anyone who knows an administrator's number exhaust
# it from the PUBLIC member endpoint and lock them out of the console during an incident.
# The per-phone allowance is a little higher: someone paged at 3am gets more than three
# attempts to receive a code on a bad network.
ADMIN_OTP_MAX_PER_PHONE=5
ADMIN_OTP_MAX_PER_IP=20
# Default lifetime of a console invite when the caller does not choose one. Bounded to
# 1..336 hours by the contract as well. An invite is a pre-authorisation to reach every
# tenant, so it must not sit in a chat history indefinitely.
ADMIN_INVITE_TTL_HOURS=72

# ---- HTTP ----
# Exact origins, comma-separated. No wildcard: browsers reject it alongside credentials,
# and reflecting arbitrary origins is the same as having no policy. Rejected at boot if it
# contains localhost while NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxy hops to trust for X-Forwarded-For. 1 behind a single load balancer. Trusting all
# hops would let a client spoof its own IP and pick its own rate-limit bucket.
TRUST_PROXY_HOPS=1

# ---- Error reporting ----
# Absent = DISABLED. No SDK init, no events, no cost. Deliberately NOT required in
# production: a missing DSN must degrade to "no error reporting", never to "refuses to
# boot" — losing visibility is bad, an API that will not start because its telemetry is
# unconfigured is worse.
#
# Sentry is errors ONLY here. It embeds OpenTelemetry for tracing, and this repo runs its
# own NodeSDK; two OTel setups fight over the global provider and the usual symptom is no
# traces at all. skipOpenTelemetrySetup keeps them apart.
#
# Phone numbers are scrubbed before any event leaves the process (see sentry-scrub.ts) —
# under DPDP, sending Indian members phone numbers to a third-party processor is a
# decision to make explicitly, not a side effect of installing an SDK.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ---- Tracing ----
# Off unless true. Points at any OTLP/HTTP collector (Grafana Cloud, Honeycomb, Jaeger).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Observability ----
LOG_LEVEL=debug             # fatal | error | warn | info | debug | trace
# Set by the build pipeline; surfaced on /healthz so "which build is on staging?" has an
# answer without guessing.
GIT_SHA=unknown
BUILT_AT=unknown

# ---- Connection pool ----
# Keep well under the managed-Postgres connection cap, remembering the cap is shared
# across every running container.
DATABASE_POOL_MAX=10

# ---- MSG91 (OTP / SMS / WhatsApp / Email delivery) ----
# BOTH or NEITHER. The auth key arrives from MSG91 immediately; the template id only exists
# after TRAI DLT approval, one to three weeks later. Setting just the key does NOT switch the
# API onto the real gateway — it stays on the console transport and keeps logging the code, so
# local sign-in survives the gap. Production refuses to boot unless both are present.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Declared but NOT read by any code today: the DLT header and entity are bound to the approved
# template on MSG91's side, so the API never sends them. Kept so the full contract is visible.
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=

# ---- Object storage (S3 or MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=forge-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Payments (sandbox) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

NODE_ENV=development

# ---- Web apps (server-side only) ----
# Where the Next apps reach the API from the SERVER. Deliberately NOT prefixed NEXT_PUBLIC:
# that would inline it into the browser bundle, and the browser never calls the API directly
# — it calls the app's own /api route, which attaches the token from an httpOnly cookie.
API_URL=http://localhost:4000
