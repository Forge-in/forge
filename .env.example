# ---- Postgres (local docker) ----
# The superuser the container starts with. Used ONLY to run
# packages/db/sql/bootstrap-roles.sql, which creates the two roles below. The application
# must never connect as this user: it is a superuser, so it bypasses row-level security and
# every tenant policy in the schema becomes decorative.
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_pw
POSTGRES_DB=forge

# Runtime connection. forge_app: owns nothing, creates nothing, NOBYPASSRLS.
# This is the only URL the API opens.
DATABASE_URL=postgresql://forge_app:app_dev_pw@localhost:5432/forge

# Migrations only, as a separate release step before the new version boots.
# forge_migrator owns the tables and can run DDL; the runtime role deliberately cannot, so
# a compromised API process cannot rewrite the schema or drop a policy.
DATABASE_MIGRATION_URL=postgresql://forge_migrator:mig_dev_pw@localhost:5432/forge

# Optional read replica for withTenantRead(). Falls back to DATABASE_URL when unset —
# the split exists in code from day one so adopting a replica is config, not a refactor.
# DATABASE_READ_URL=

# First-time setup (creates forge_app and forge_migrator):
#   psql "postgresql://forge:forge_dev_pw@localhost:5432/forge" \
#     -v migrator_password=mig_dev_pw -v app_password=app_dev_pw \
#     -f packages/db/sql/bootstrap-roles.sql
#   pnpm --filter @forge/db db:migrate

# ---- Redis (local docker) ----
REDIS_URL=redis://localhost:6379

# ---- Auth / JWT (generate strong random values; NEVER commit real ones) ----
# Validated at boot: minimum 32 characters, must not start with a placeholder word, and
# the two secrets must differ — sharing them would let a refresh token be presented as an
# access token. The API refuses to start otherwise, rather than signing with `undefined`.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900          # 15 min in seconds
JWT_REFRESH_TTL=2592000     # 30 days in seconds

# ---- HTTP ----
# Exact origins, comma-separated. No wildcard: browsers reject it alongside credentials,
# and reflecting arbitrary origins is the same as having no policy. Rejected at boot if it
# contains localhost while NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Proxy hops to trust for X-Forwarded-For. 1 behind a single load balancer. Trusting all
# hops would let a client spoof its own IP and pick its own rate-limit bucket.
TRUST_PROXY_HOPS=1

# ---- Observability ----
LOG_LEVEL=debug             # fatal | error | warn | info | debug | trace
# Set by the build pipeline; surfaced on /healthz so "which build is on staging?" has an
# answer without guessing.
GIT_SHA=unknown
BUILT_AT=unknown

# ---- Connection pool ----
# Keep well under the managed-Postgres connection cap, remembering the cap is shared
# across every running container.
DATABASE_POOL_MAX=10

# ---- MSG91 (OTP / SMS / WhatsApp / Email delivery) ----
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_DLT_TE_ID=

# ---- Object storage (S3 or MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=forge-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Payments (sandbox) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

NODE_ENV=development

# ---- Web apps (server-side only) ----
# Where the Next apps reach the API from the SERVER. Deliberately NOT prefixed NEXT_PUBLIC:
# that would inline it into the browser bundle, and the browser never calls the API directly
# — it calls the app's own /api route, which attaches the token from an httpOnly cookie.
API_URL=http://localhost:4000
